# Gfloge configuration. Copy to .env and adjust. All values are read by the
# api and worker containers; the compose file injects the database coordinates.

# ----- Required -----
GF_DB_PASSWORD=change-me
GF_SECRET=                # 32+ random chars: openssl rand -hex 32, used for session + credential encryption

# ----- Bootstrap / demo -----
# With an empty database:
#   GF_SEED_DEMO=1  seeds a clearly labelled demo dataset incl. demo logins
#   GF_ADMIN_EMAIL + GF_ADMIN_PASSWORD  create only an administrator instead
GF_SEED_DEMO=1
# GF_ADMIN_EMAIL=admin@example.com
# GF_ADMIN_PASSWORD=

# ----- Deployment -----
GF_HTTP_PORT=8080
GF_TRUST_PROXY=0          # set to 1 behind a TLS reverse proxy
GF_LOG_LEVEL=info
# GF_WEB_DIST untouched: the image bundles apps/web/dist and serves it

# ----- Providers (optional; demo works without any) -----
# GF_PROVIDERS_LIVE=opensky,adsblol
# GF_PROVIDERS_SCHEDULE=airlabs
# GF_OPENSKY_CLIENT_ID=
# GF_OPENSKY_CLIENT_SECRET=
# GF_AIRLABS_API_KEY=
# GF_HISTORICAL_DATA_DIR=/data
# Persistent directory for optional historical Parquet datasets (mounted volume).
# Must be writable by the container runtime user.